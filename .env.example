# Required UniFi controller settings (no real/default credentials)
UNIFI_URL=https://controller.example.internal:8443
UNIFI_USER=__REQUIRED__
UNIFI_PASS=__REQUIRED__
UNIFI_SITE=default

# API protection for all /api endpoints
API_KEY=__REQUIRED__
API_AUTH_ENABLED=true
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=60
FORCE_REFRESH_MIN_INTERVAL_SEC=30

# TLS behavior for UniFi API requests
UNIFI_ALLOW_SELF_SIGNED_CERT=false

# Application runtime
PORT=3000
CACHE_EXPIRY_SEC=15
HOST_PORT=3843
MOCK_MODE=false
