# =========================================================================
# UniFi Network Health Analyzer - Environmental Configuration Template
# =========================================================================

# --- 1. UniFi Network Controller Connection Settings ---
# The IP address or hostname of your UniFi Controller, UDM, or Cloud Key
UNIFI_HOST=172.16.0.200

# The API port of the UniFi Controller (usually 8443, or 443 on modern UDM/UXG)
UNIFI_PORT=8443

# Controller credentials (A Read-Only/Observer user is highly recommended!)
UNIFI_USER=observer
UNIFI_PASS=your_secure_unifi_password_here

# UniFi site ID (default is 'default'; look at your browser URL in UniFi to verify)
UNIFI_SITE=default

# --- 2. Application Dashboard Settings ---
# Internal server port (keep as 3000 inside Docker containers)
PORT=3000

# Controller cache duration in seconds. Minimizes hits/load on your controller API
CACHE_EXPIRY_SEC=15

# --- 3. Docker Orchestration Host Port ---
# The unique port on the host (e.g. your Proxmox Debian LXC) where the app is exposed
HOST_PORT=3843
